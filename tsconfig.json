{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@m8/avatars": ["./packages/avatars/src/index.ts"],
      "@m8/contract": ["./packages/contract/src/index.ts"],
      "@m8/core": ["./packages/core/src/index.ts"],
      "@m8/game-chess": ["./packages/games/chess/src/index.ts"],
      "@m8/game-dominoes": ["./packages/games/dominoes/src/index.ts"],
      "@m8/game-draughts": ["./packages/games/draughts/src/index.ts"],
      "@m8/game-tic-tac-toe": ["./packages/games/tic-tac-toe/src/index.ts"],
      "@m8/protocol": ["./packages/protocol/src/index.ts"],
      "@m8/tokens": ["./packages/tokens/src/index.ts"],
      "@m8/transport": ["./packages/transport/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "*.ts"],
  // Each browser app has its own project — apps/tv because its libraries are
  // narrowed to what a 2020 television has, apps/phone because Vite reads the
  // nearest tsconfig and it must find the same one on a laptop and inside the
  // container. Their sources are excluded here so each is checked once, under
  // its own options, rather than twice with this looser program passing first.
  // `npm run typecheck` runs all three; `scripts/typecheck-projects.test.ts`
  // fails if a project stops being run or stops being excluded here.
  //
  // The default exclusions are restated because naming this key replaces them.
  "exclude": ["node_modules", "**/dist", "apps/tv/src", "apps/phone/src"]
}
